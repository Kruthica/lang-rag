# Required for answering questions through Hugging Face Inference.
HF_TOKEN=
EMBEDDING_PROVIDER=hash

# Comma-separated Vercel URL(s), for example:
# CORS_ORIGINS=https://your-project.vercel.app
CORS_ORIGINS=http://localhost:5173

# Render's filesystem is ephemeral without a paid persistent disk.
UPLOAD_DIR=/tmp/uploads
CHROMA_DB_DIR=/tmp/vectorstore

# Optional tuning.
LLM_TIMEOUT_SECONDS=120
CHROMA_COLLECTION_NAME=rag_documents
